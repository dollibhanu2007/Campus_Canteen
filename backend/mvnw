#!/bin/sh
MAVEN_VERSION="3.9.9"
MAVEN_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_HOME="$MAVEN_DIR/apache-maven-$MAVEN_VERSION"
MAVEN_ZIP="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION-bin.zip"
MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.zip"

if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
    echo "[INFO] Downloading Maven $MAVEN_VERSION..."
    mkdir -p "$MAVEN_DIR"
    curl -fsSL "$MAVEN_URL" -o "$MAVEN_ZIP" || wget -q "$MAVEN_URL" -O "$MAVEN_ZIP"
    unzip -q -o "$MAVEN_ZIP" -d "$MAVEN_DIR"
    rm -f "$MAVEN_ZIP"
    chmod +x "$MAVEN_HOME/bin/mvn"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
